{
  "name": "techcalendar",
  "version": "1.0.0",
  "description": "A curated, subscribable ICS calendar of major confirmed tech industry events.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "update": "tsx src/cli/update.ts",
    "build": "tsx src/cli/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "fast-xml-parser": "^4.5.1",
    "ical-generator": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
